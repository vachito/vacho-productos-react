{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "lib": ["ESNext"],
    "target": "ES2022",

    "module": "commonjs",
    "moduleResolution": "node",

    "strict": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,

    "types": ["jest", "node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
